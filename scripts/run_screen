#!/usr/bin/env bash
set -u

usage() {
  cat <<'EOF'
Run screen on a serial device and reconnect after disconnects.

Usage:
  run_screen <device> <baud>

Examples:
  run_screen /dev/cu.usbmodem1334301 115200
  run_screen /dev/ttyACM0 115200

If screen exits because the device reset or disappeared, this script waits for
the same device path to return and reconnects. Press Ctrl-C while waiting for
the device or between reconnect attempts to stop.
EOF
}

log() {
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}

sanitize_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

wait_for_device() {
  local dev="$1"
  local warned=0

  while [[ ! -e "$dev" ]]; do
    if [[ "$warned" -eq 0 ]]; then
      log "Waiting for $dev ..."
      warned=1
    fi
    sleep 1
  done
}

monitor_device() {
  local dev="$1"
  local session="$2"

  while true; do
    if [[ ! -e "$dev" ]]; then
      log "Device disconnected: $dev"
      screen -S "$session" -X quit >/dev/null 2>&1 || true
      return 0
    fi
    sleep 1
  done
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "$#" -ne 2 ]]; then
  usage >&2
  exit 2
fi

DEV="$1"
BAUD="$2"
RECONNECT_DELAY="${RUN_SCREEN_RECONNECT_DELAY:-2}"

if ! command -v screen >/dev/null 2>&1; then
  echo "screen is required but was not found in PATH." >&2
  exit 1
fi

case "$BAUD" in
  ''|*[!0-9]*)
    echo "Invalid baud rate: $BAUD" >&2
    exit 2
    ;;
esac

case "$RECONNECT_DELAY" in
  ''|*[!0-9]*)
    echo "Invalid RUN_SCREEN_RECONNECT_DELAY: $RECONNECT_DELAY" >&2
    exit 2
    ;;
esac

BASE_NAME="$(basename "$DEV")"
SESSION_BASE="run_screen_$(sanitize_name "$BASE_NAME")_$$"
MONITOR_PID=""

run_stty() {
  stty "$@" 2>/dev/null || stty "$@" 2>/dev/null </dev/tty
}

ORIG_STTY="$(run_stty -g || true)"

cleanup_monitor() {
  if [[ -n "${MONITOR_PID:-}" ]]; then
    kill "$MONITOR_PID" >/dev/null 2>&1 || true
    wait "$MONITOR_PID" >/dev/null 2>&1 || true
    MONITOR_PID=""
  fi
}

restore_terminal() {
  if [[ -n "${ORIG_STTY:-}" ]]; then
    run_stty "$ORIG_STTY" || run_stty sane || true
  else
    run_stty sane || true
  fi
  run_stty isig intr '^C' || true
}

handle_int() {
  cleanup_monitor
  restore_terminal
  exit 130
}

handle_term() {
  cleanup_monitor
  restore_terminal
  exit 143
}

trap handle_int INT
trap handle_term TERM

while true; do
  wait_for_device "$DEV"

  if [[ ! -r "$DEV" || ! -w "$DEV" ]]; then
    log "Warning: $DEV exists but is not readable/writable by this user."
  fi

  SESSION="${SESSION_BASE}_$(date '+%s')"
  log "Starting screen session $SESSION on $DEV at $BAUD baud."

  monitor_device "$DEV" "$SESSION" &
  MONITOR_PID="$!"

  screen -S "$SESSION" "$DEV" "$BAUD"
  SCREEN_STATUS="$?"

  restore_terminal
  cleanup_monitor

  if [[ "$SCREEN_STATUS" -ne 0 ]]; then
    log "screen exited with status $SCREEN_STATUS; reconnecting."
  else
    log "screen exited; reconnecting."
  fi

  if [[ ! -e "$DEV" ]]; then
    log "Waiting for $DEV to reconnect ..."
  elif [[ "$RECONNECT_DELAY" -gt 0 ]]; then
    log "Reconnect in ${RECONNECT_DELAY}s. Press Ctrl-C now to stop."
    sleep "$RECONNECT_DELAY"
  fi
done
