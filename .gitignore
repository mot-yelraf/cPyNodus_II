# Python host-side cache artifacts
__pycache__/
*.py[cod]
*$py.class

# Test and lint caches
.pytest_cache/
.ruff_cache/

# Local editor state
.vscode/

# macOS metadata
.DS_Store
._*

# Live device and host configuration
/settings.toml
/sensor_i2c.toml
/sensor_soil.toml
/switch.toml
scripts/nodus_getlogs.toml

# OTA release private keys must never be committed
*ota-private*.pem
*ota-signing*.pem

# Generated build outputs
/build/
